{
  "name": "@relay/messaging-sdk",
  "version": "0.1.0",
  "description": "Relay Messaging SDK — encrypted messaging for your app. We handle identity, key exchange and encryption; you add the SDK and go.",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "relay",
    "messaging",
    "e2ee",
    "encryption",
    "sdk",
    "chat"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
