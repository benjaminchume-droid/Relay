# Relay — Vite environment (only VITE_* reaches the client bundle)
# Copy to .env for local dev. Production sets these in Vercel project env;
# the Android release build injects them via GitHub Actions secrets.
#
# NOTE: on relayid.vercel.app the app talks to its own origin — /rest/v1/*,
# /auth/v1/*, /storage/v1/* and /realtime/v1/* are proxied server-side
# (vercel.json). These vars are the direct fallback for dev + Capacitor.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# "Sync from Genjutsu" on the developer page reads public business profiles
# through the Genjutsu app domain (never a provider URL):
VITE_GENJUTSU_URL=https://genjutsu-umber.vercel.app
VITE_GENJUTSU_PUBLISHABLE_KEY=

# Calls: TURN fallback for carrier NAT (optional)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
